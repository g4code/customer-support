{
  "name": "g4/customer-support",
  "type": "library",
  "description": "customer support php library",
  "keywords": [
    "customer",
    "support"
  ],
  "homepage": "https://github.com/g4code/customer-support",
  "license": "MIT",
  "authors": [],
  "autoload": {
    "psr-4": {
      "G4\\CustomerSupport\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit"           : "^11.5",
    "codeception/codeception"   : "^5.1",
    "squizlabs/php_codesniffer" : "^3.10",
    "g4/code-coverage"          : "2.*"
  },
  "require": {
    "php"             : ">=8.3",
    "g4/value-object" : "*",
    "g4/gateway"      : "3.*",
    "g4/constants"    : "0.*",
    "g4/factory"      : "1.*"
  },
  "scripts": {
    "unit-test": [
      "XDEBUG_MODE=coverage php8.3 vendor/bin/phpunit -c tests/unit/phpunit.xml --colors=always --coverage-html tests/unit/coverage"
    ],
    "test-coverage": [
      "XDEBUG_MODE=coverage php8.3 ./vendor/bin/phpunit --colors=always -c tests/unit/phpunit.xml --coverage-text"
    ],
    "test-report": [
      "XDEBUG_MODE=coverage php8.3 ./vendor/bin/phpunit --colors=always -c tests/unit/phpunit.xml --coverage-clover=tests/unit/coverage/code-coverage.xml"
    ],
    "code-coverage": [
      "XDEBUG_MODE=coverage php8.3 ./vendor/bin/code-coverage -p 90 -f tests/unit/coverage/code-coverage.xml"
    ],
    "psr2": [
      "php8.3 ./vendor/bin/phpcs --colors --standard=PSR2 src/"
    ],
    "psr2-fix": [
      "php8.3 ./vendor/bin/phpcbf --colors --standard=PSR2 src/"
    ]
  }
}
